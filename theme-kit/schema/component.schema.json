{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenix.local/theme-kit/schema/component.schema.json",
  "title": "Scenix component manifest",
  "description": "One versioned component contract in the five-level Scenix model (token, atom, molecule, organism, template). A renderer must draw every declared state; events travel up to the host.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "level",
    "props",
    "states",
    "events",
    "slots",
    "a11y",
    "targets",
    "budget"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(atom|molecule|organism|template)\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
      "description": "Stable registry key, e.g. molecule.tile or atom.button."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Contract version. Bump when a prop, state or event changes incompatibly."
    },
    "level": {
      "type": "string",
      "enum": ["atom", "molecule", "organism", "template"]
    },
    "summary": {
      "type": "string",
      "minLength": 8,
      "maxLength": 280,
      "description": "One sentence a gallery reader can understand."
    },
    "props": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 40,
      "description": "Named public inputs. Map keys are the prop names.",
      "additionalProperties": { "$ref": "#/$defs/prop" }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "default" },
      "description": "Exhaustive visual states, always including default. A renderer that cannot draw one is invalid.",
      "items": { "$ref": "#/$defs/state" }
    },
    "events": {
      "type": "array",
      "uniqueItems": true,
      "description": "Events emitted upward to the host. Components never call the hub, prefs or activities.",
      "items": { "$ref": "#/$defs/event" }
    },
    "slots": {
      "type": "array",
      "description": "Named composition holes and the component ids each accepts.",
      "items": { "$ref": "#/$defs/slot" }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "label"],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Accessible name. {{prop}} placeholders are resolved by the renderer."
        },
        "hint": { "type": "string" },
        "selected": { "type": "boolean" },
        "value": { "type": "string" }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["android", "ios", "web"],
      "properties": {
        "android": { "$ref": "#/$defs/target" },
        "ios": { "$ref": "#/$defs/target" },
        "web": { "$ref": "#/$defs/target" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxViews", "maxLayers", "maxImageBytes"],
      "properties": {
        "maxViews": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "Maximum instantiated views/nodes for one component instance."
        },
        "maxLayers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum composited layers, including one optional blur layer."
        },
        "maxImageBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000000,
          "description": "Maximum bytes requested for the largest declared image size."
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "id": { "pattern": "^atom\\." } }, "required": ["id"] },
      "then": { "properties": { "level": { "const": "atom" } } }
    },
    {
      "if": { "properties": { "id": { "pattern": "^molecule\\." } }, "required": ["id"] },
      "then": { "properties": { "level": { "const": "molecule" } } }
    },
    {
      "if": { "properties": { "id": { "pattern": "^organism\\." } }, "required": ["id"] },
      "then": { "properties": { "level": { "const": "organism" } } }
    },
    {
      "if": { "properties": { "id": { "pattern": "^template\\." } }, "required": ["id"] },
      "then": { "properties": { "level": { "const": "template" } } }
    }
  ],
  "$defs": {
    "state": {
      "type": "string",
      "enum": [
        "default",
        "hover",
        "focus",
        "pressed",
        "selected",
        "active",
        "disabled",
        "loading",
        "empty",
        "buffering",
        "playing",
        "paused",
        "complete",
        "error",
        "live",
        "dragging",
        "ranked",
        "continue"
      ]
    },
    "event": {
      "type": "string",
      "enum": [
        "press",
        "longPress",
        "focus",
        "blur",
        "change",
        "seek",
        "seekStart",
        "seekEnd",
        "play",
        "pause",
        "retry",
        "open",
        "close",
        "scroll",
        "select"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "button",
        "link",
        "img",
        "text",
        "heading",
        "group",
        "list",
        "listitem",
        "navigation",
        "progressbar",
        "slider",
        "switch",
        "checkbox",
        "tab",
        "tablist",
        "presentation"
      ]
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "image",
            "enum",
            "color",
            "token",
            "array",
            "object"
          ]
        },
        "required": { "type": "boolean", "default": false },
        "description": { "type": "string", "maxLength": 240 },
        "default": {},
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": ["string", "number", "boolean"] }
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "maxLength": { "type": "integer", "minimum": 1 },
        "sizes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^w[0-9]{2,5}$" }
        },
        "tokenGroup": {
          "type": "string",
          "enum": ["color", "space", "radius", "type", "focus", "anim", "player", "pack"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
          "then": { "required": ["enum"] }
        },
        {
          "if": { "properties": { "type": { "const": "image" } }, "required": ["type"] },
          "then": { "required": ["sizes"] }
        }
      ]
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "accepts"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "accepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(atom|molecule|organism|template)\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
          }
        },
        "optional": { "type": "boolean", "default": true },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "focus"],
      "properties": {
        "renderer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Registry renderer name on that platform."
        },
        "focus": {
          "type": "string",
          "enum": [
            "host-ring",
            "host-glow",
            "focusEffect",
            "focus-engine",
            "focus-visible",
            "none"
          ]
        },
        "notes": { "type": "string", "maxLength": 240 }
      }
    }
  }
}
