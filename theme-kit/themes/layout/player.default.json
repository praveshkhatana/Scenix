{
  "template": "player",
  "theme": "scene.apple",
  "description": "PlayerActivity cinema chrome: no header. A bottom gradient carries the title row (title, certificate, LIVE, meta, the running-quality pill), a full-width timeline and one transport line; live drops the timeline, elapsed pair, speed and rewind. The error, track-menu and up-next cards sit over the picture, and the skip-intro chip lives outside the chrome so it survives the auto-hide.",
  "root": {
    "type": "overlay",
    "children": [
      {
        "component": "atom.surface",
        "props": {
          "tone": "stage",
          "radius": 0,
          "border": false
        }
      },
      {
        "type": "column",
        "safe": "tv",
        "children": [
          {
            "type": "row",
            "slot": "title",
            "props": {
              "gap": "space.listItem"
            },
            "children": [
              {
                "component": "atom.label",
                "props": {
                  "text": "@title",
                  "type": "h3",
                  "tone": "ink",
                  "weight": "bold"
                }
              },
              {
                "component": "atom.chip",
                "when": "@certificate",
                "props": {
                  "label": "@certificate",
                  "tone": "outline"
                }
              },
              {
                "component": "atom.chip",
                "when": "@live",
                "props": {
                  "label": "LIVE",
                  "tone": "solid",
                  "icon": "live"
                }
              },
              {
                "component": "atom.label",
                "props": {
                  "text": "@meta",
                  "type": "meta",
                  "tone": "ink2"
                }
              },
              {
                "component": "atom.chip",
                "when": "@quality",
                "props": {
                  "label": "@quality",
                  "tone": "muted"
                }
              }
            ]
          },
          {
            "component": "molecule.seek-bar",
            "when": "@vod",
            "props": {
              "position": "@progress.position",
              "buffered": "@progress.buffered",
              "duration": "@progress.duration",
              "hint": "time"
            }
          },
          {
            "type": "row",
            "slot": "transport",
            "children": [
              {
                "component": "atom.button",
                "props": {
                  "label": "Play",
                  "kind": "flat",
                  "icon": "play"
                }
              },
              {
                "component": "atom.icon",
                "when": "@vod",
                "props": {
                  "name": "rewind",
                  "label": "Back 10 seconds"
                }
              },
              {
                "type": "divider"
              },
              {
                "component": "atom.icon",
                "props": {
                  "name": "subtitles",
                  "label": "Subtitles"
                }
              },
              {
                "component": "atom.icon",
                "props": {
                  "name": "audio",
                  "label": "Audio"
                }
              },
              {
                "component": "atom.icon",
                "when": "@vod",
                "props": {
                  "name": "speed",
                  "label": "Speed"
                }
              },
              {
                "component": "atom.icon",
                "props": {
                  "name": "quality",
                  "label": "Quality"
                }
              },
              {
                "component": "atom.icon",
                "props": {
                  "name": "aspect",
                  "label": "Picture size"
                }
              },
              {
                "type": "divider"
              },
              {
                "component": "atom.icon",
                "when": "@next",
                "props": {
                  "name": "forward",
                  "label": "Next episode"
                }
              },
              {
                "component": "atom.icon",
                "when": "@series",
                "props": {
                  "name": "episodes",
                  "label": "Episodes"
                }
              },
              {
                "component": "atom.label",
                "when": "@vod",
                "props": {
                  "text": "@elapsed",
                  "type": "meta",
                  "tone": "ink"
                }
              },
              {
                "component": "atom.label",
                "when": "@vod",
                "props": {
                  "text": "@remaining",
                  "type": "meta",
                  "tone": "ink2"
                }
              }
            ]
          }
        ]
      },
      {
        "component": "atom.chip",
        "when": "@skipIntro",
        "props": {
          "label": "Skip intro",
          "tone": "solid",
          "anchor": "bottom-end",
          "outside": "chrome"
        }
      },
      {
        "component": "atom.surface",
        "when": "@error",
        "slot": "cards",
        "props": {
          "tone": "panel",
          "radius": "radius.panel"
        }
      },
      {
        "component": "atom.surface",
        "when": "@next",
        "slot": "cards",
        "props": {
          "tone": "panel",
          "radius": "radius.panel",
          "anchor": "bottom-end"
        }
      },
      {
        "component": "atom.surface",
        "when": "@menu",
        "slot": "cards",
        "props": {
          "tone": "panel",
          "radius": "radius.panel",
          "anchor": "center"
        }
      }
    ]
  }
}
