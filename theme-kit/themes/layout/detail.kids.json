{
  "template": "detail",
  "theme": "scene.kids",
  "description": "Kids title page: the yellow wall splits into words at the left and one tall art panel at the right, then Resume / My List, cast and related shelves. No reaction band.",
  "root": {
    "type": "stack",
    "children": [
      {
        "component": "organism.wall",
        "props": {
          "tone": "color.bg",
          "gradient": ["color.stageYellow", "color.stageDeep"]
        }
      },
      {
        "type": "column",
        "safe": "tv",
        "gap": "space.rowGap",
        "children": [
          {
            "component": "organism.detail.header",
            "props": {
              "record": "@record",
              "variant": "split",
              "artSide": "end",
              "artWidth": 0.58,
              "titleType": "h1",
              "actions": "@actions",
              "reactions": false,
              "showLogo": false
            }
          },
          {
            "component": "organism.rail",
            "when": "@cast.length",
            "props": {
              "title": "Cast",
              "items": "@cast",
              "variant": "poster",
              "caption": "overlay",
              "seeAll": false
            }
          },
          {
            "component": "organism.rail",
            "when": "@episodes.length",
            "props": {
              "title": "Episodes",
              "items": "@episodes",
              "variant": "landscape",
              "caption": "below",
              "seeAll": true,
              "total": "@episodes.total"
            }
          },
          {
            "component": "organism.rail",
            "when": "@related.length",
            "props": {
              "title": "More like this",
              "items": "@related",
              "variant": "poster",
              "caption": "overlay",
              "seeAll": true,
              "total": "@related.total"
            }
          }
        ]
      }
    ]
  }
}
