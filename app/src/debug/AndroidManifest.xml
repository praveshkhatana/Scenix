<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: `adb shell am start` can open PlayerActivity (and the channel wall) directly
     with a channel/movie identity in extras, which makes scripted playback tests — zapping, resume,
     failover — reproducible. The release manifest keeps nothing exported, exactly as before. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <activity
            android:name=".LiveChannelsActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <!-- The design-system catalogue is a debug tool: it renders the real components and is
             drivable by the capture script. Release builds do not contain it. -->
        <activity
            android:name=".StudioActivity"
            android:exported="true" />
    </application>
</manifest>
