<resources>
    <style name="Theme.Scenix" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- The launcher's window background before MainActivity can paint anything: the brand mark,
         not a black rectangle. The activity then keeps the same theme from onCreate onward. -->
    <style name="Theme.Scenix.Splash" parent="Theme.Scenix">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
