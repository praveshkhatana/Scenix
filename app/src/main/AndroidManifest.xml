<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app is a client of the hub: HTTP JSON only, no other network use. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- TV-only: this app is never a phone app. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The hub is a machine in the same house: http://192.168.x.x:8788 is the normal answer.
         Android blocks cleartext by default, which would silently leave the app on its offline
         fixtures. HTTPS works too and needs nothing here. -->
    <application
        android:name=".ScenixApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/tv_banner"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher_tv"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scenix">

        <activity
            android:name=".MainActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize">

            <!-- Android TV home screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Also reachable from a normal launcher while developing (TV device only, see uses-feature) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: tv://detail/<identity> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tv" />
            </intent-filter>
        </activity>
    </application>

</manifest>
