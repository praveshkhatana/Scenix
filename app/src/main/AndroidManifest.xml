<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app is a client of the hub: HTTP JSON only, plus one UDP announcement search
         (core/HubDiscovery.kt). No other network use. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The multicast lock is what lets a hub's LAN announcement reach this TV at all; without it
         most Wi-Fi firmwares drop group traffic. Held only for the length of one search. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- TV-only: this app is never a phone app. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- A paired hub is usually http://&lt;hub-host&gt;:8788 on the same network, and standalone mode
         serves the same contract from this app. Android blocks cleartext by default, which would
         silently leave the app on its offline fixtures. HTTPS works too and needs nothing here. -->
    <application
        android:name=".ScenixApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/tv_banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scenix">

        <activity
            android:name=".MainActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize">

            <!-- Android TV home screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Also reachable from a normal launcher while developing (TV device only, see uses-feature) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: tv://detail/<identity> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tv" />
            </intent-filter>
        </activity>

        <!--
            The product: the hub's web interface in a WebView, with media3 underneath it. Hub mode
            loads the page from the hub; standalone mode loads it from this app's own server
            (core/LocalServer.kt) out of assets/web/. Started by MainActivity after its one hub
            probe, or by a `tv://` deep link with a `url` extra naming the page route. configChanges
            keeps the WebView and its video surface alive through the orientation and density changes
            Android TV makes on its own.
        -->
        <activity
            android:name=".PinActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProfilesActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DetailActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- Native TV playback. The hub still ranks and hands over the copy; this activity draws the
             picture (Media3) and the remote-first chrome around it. Browsers keep the web player. -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".BrowseActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".WebShellActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
