<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app is a client of the hub: HTTP JSON only, plus one UDP announcement search
         (core/HubDiscovery.kt). No other network use. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reading this TV's own media. SDK 30-32 uses the storage permission; 33+ splits it by type. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Media playback libraries can post transport notifications on Android 13+. The app does
         not request this at runtime unless it starts such a foreground/notification flow, but the
         declared permission keeps that platform-owned path lawful when it is used. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The multicast lock is what lets a hub's LAN announcement reach this TV at all; without it
         most Wi-Fi firmwares drop group traffic. Held only for the length of one search. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Auto-update hands a downloaded APK to the package installer (core/Updates.kt). The person
         holding the remote still confirms on Android's own screen; this only allows that handoff. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ package visibility: the handoff is an implicit VIEW of an APK, and without this
         the app cannot see the system installer at all — startActivity then fails with "no activity
         found" and the update stops one step short of Android's own confirm screen. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
        </intent>
    </queries>

    <!-- TV-only: this app is never a phone app. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <!-- Multicast discovery can use Wi-Fi when it exists, but the app must remain installable on
         Ethernet-only televisions. The permission above is a capability, not a hardware demand. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Game mode wants a controller but never demands one: plenty of browser ports play with the
         remote, and the TV may have no pad paired yet. -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- A paired hub is usually http://&lt;hub-host&gt;:8788 on the same network, and standalone mode
         serves the same contract from this app. Android blocks cleartext by default, which would
         silently leave the app on its offline fixtures. HTTPS works too and needs nothing here. -->
    <application
        android:name=".ScenixApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/tv_banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scenix">

        <activity
            android:name=".MainActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Scenix.Splash"
            android:windowSoftInputMode="adjustResize">

            <!-- Android TV home screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Also reachable from a normal launcher while developing (TV device only, see uses-feature) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: tv://detail/<identity> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tv" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PinActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProfilesActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TextEntryActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AddonsActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".GamesActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- One console-library grammar for every zone: Home, Movies, Series, Games, Live. -->
        <activity
            android:name=".ShelfActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- A game's own console-style page: tabs, facts, sessions, and the START box. -->
        <activity
            android:name=".GameHubActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- The game player keeps its own keyboard/navigation config contract: a pad pairing or a
             controller arriving must not restart the WebView and drop the running game. -->
        <activity
            android:name=".GameActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- The embedded-engine player: same contract as the WebView player, Gecko underneath, so
             a pad pairing or a controller arriving must not restart the running game either. -->
        <activity
            android:name=".CoiGameActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- Household controllers: live list of connected pads, a raw button test, and the door to
             Android's Bluetooth pairing. -->
        <activity
            android:name=".ControllersActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DebridActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LiveChannelsActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SystemActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LiveSettingsActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CategoriesActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SourcePacksActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ManageProfilesActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SearchActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SectionActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DetailActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- Native TV playback. The hub still ranks and hands over the copy; this activity draws the
             picture (Media3) and the remote-first chrome around it. Browsers keep the web player. -->
        <activity
            android:name=".TrailerActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".PlayerActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".BrowseActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- The only file this app shares with another app: an update APK it downloaded, handed to
             the package installer through this provider (core/Updates.kt). Android 7+ refuses a
             file:// URI for installs, so the handoff must ride a content:// grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
